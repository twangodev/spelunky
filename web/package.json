{
  "name": "spelunky-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "build": "bun run check && vite build",
    "preview": "wrangler dev --ip 127.0.0.1",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "wrangler": "4.151.1",
    "@types/node": "26.6.5"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
